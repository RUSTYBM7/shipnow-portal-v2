# Wales HQ AI Server Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://zygoqqsgzhgpvlpttfbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MiniMax API (for AI responses)
