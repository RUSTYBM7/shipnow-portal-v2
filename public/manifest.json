  "shortcuts": [
    {
      "name": "Track Package",
      "short_name": "Track",
      "description": "Track your AirPak shipment status and location",
      "url": "/#/tracking",
      "icons": [{ "src": "/shortcut-track.png", "sizes": "96x96" }]
    },
    {
      "name": "New Shipment",
      "short_name": "Ship",
      "description": "Create and schedule a new shipment",
      "url": "/#/ship",
      "icons": [{ "src": "/shortcut-ship.png", "sizes": "96x96" }]
    },
    {
      "name": "Support",
      "short_name": "Support",
      "description": "Contact customer support team",
      "url": "/#/support",
      "icons": [{ "src": "/shortcut-support.png", "sizes": "96x96" }]
    },
    {
      "name": "My Shipments",
      "short_name": "History",
      "description": "View your shipment history",
      "url": "/#/history",
      "icons": [{ "src": "/shortcut-history.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard - View all your shipments at a glance"
    },
    {
      "src": "/screenshots/tracking-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Track Shipment - Real-time tracking with map view"
    },
    {
      "src": "/screenshots/create-shipment.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Create Shipment - Quick and easy booking"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.airpak.express",
      "id": "com.airpak.express"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/#/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "description",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/#/open-file",
      "accept": [".pdf", ".png", ".jpg", ".jpeg"],
      "icons": [{ "src": "/file-icon.png", "sizes": "96x96" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "airpak",
      "url": "/#/track/%s"
    }
  ],
  "widgets": [
    {
      "id": "tracking-widget",
      "name": "AirPak Tracking Widget",
      "description": "Add tracking widget to your website",
      "screenshots": ["/widgets/tracking-preview.png"],
      "url": "/widgets/tracking.js"
    }
  ],
  "backdrop_filter": "blur(8px)",
  "capture_links": "all",
