{
  "name": "AirPak Express - Shipping Partner",
  "short_name": "AirPak",
  "description": "Fast & Reliable Shipping Partner - Track shipments, create labels, and manage deliveries with ease.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "orientation_lock": "portrait",
  "theme_color": "#DC2626",
  "background_color": "#0F172A",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "shopping", "utilities"],
  "iarc_rating_id": "airpak-express-v1",
  "launch_handler": {
    "client_mode": "navigate-existing",
    "route_matches": [
      {
        "pathname": "/tracking",
        "client_mode": "focus-existing"
      },
      {
        "pathname": "/ship",
        "client_mode": "navigate-existing"
      },
      {
        "pathname": "/support",
        "client_mode": "focus-existing"
      }
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
